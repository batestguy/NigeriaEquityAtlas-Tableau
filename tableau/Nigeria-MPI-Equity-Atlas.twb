              <member value='&quot;UCDP events per 100k&quot;' />
              <member value='&quot;UCDP events per 100k, log(1+rate)&quot;' />
              <member value='&quot;UCDP deaths per 100k&quot;' />
              <member value='&quot;UCDP deaths per 100k, log(1+rate)&quot;' />
              <member value='&quot;UCDP deaths per 100k, upper estimate&quot;' />
              <member value='&quot;UCDP deaths per 100k, upper, log(1+rate)&quot;' />
              <member value='&quot;MPI standard error (2021)&quot;' />
              <member value='&quot;H standard error (2021)&quot;' />
              <member value='&quot;Vulnerable to poverty, % of population (2021)&quot;' />
              <member value='&quot;In severe poverty, % of population (2021)&quot;' />
