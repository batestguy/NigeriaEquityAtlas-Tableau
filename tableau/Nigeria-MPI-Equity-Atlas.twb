    </worksheet>
    <worksheet name='How measures pair'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='13'>How measures pair</run><run fontsize='9'>  choose any two measures; points, not a test · each pane's quadratic line only describes its own marks -- no slope, no coefficient, no claim · panes cut on the 2021 poorest-12 split, so pane slopes are range-restricted · logged axes are log(1+rate) and keep zero-event states on the zero line</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Pairs board' name='federated.0mpipairs' />
          </datasources>
          <datasource-dependencies>
      <column caption='pcode' datatype='string' name='[pcode]' role='dimension' type='nominal' />
      <column caption='state' datatype='string' name='[state]' role='dimension' type='nominal' semantic-role='[State].[Name]' />
      <column caption='poverty_group' datatype='string' name='[poverty_group]' role='dimension' type='nominal' />
      <column caption='survey_year' datatype='integer' name='[survey_year]' role='dimension' type='ordinal' />
      <column caption='survey' datatype='string' name='[survey]' role='dimension' type='nominal' />
      <column caption='H (% poor)' datatype='real' name='[headcount_ratio_pct]' role='measure' type='quantitative' />
      <column caption='MPI' datatype='real' name='[mpi]' role='measure' type='quantitative' />
      <column caption='Depth (avg deprivation among the poor, %)' datatype='real' name='[intensity_pct]' role='measure' type='quantitative' />
      <column caption='Capital temperature in the round (C)' datatype='real' name='[temp_mean_c]' role='measure' type='quantitative' />
      <column caption='UCDP events per 100k' datatype='real' name='[events_per_100k]' role='measure' type='quantitative' />
      <column caption='UCDP events per 100k, log(1+rate)' datatype='real' name='[log1p_events_per_100k]' role='measure' type='quantitative' />
      <column caption='UCDP deaths per 100k' datatype='real' name='[fatalities_per_100k]' role='measure' type='quantitative' />
      <column caption='UCDP deaths per 100k, log(1+rate)' datatype='real' name='[log1p_fatalities_per_100k]' role='measure' type='quantitative' />
      <column caption='UCDP deaths per 100k, upper estimate' datatype='real' name='[fatalities_per_100k_high]' role='measure' type='quantitative' />
      <column caption='UCDP deaths per 100k, upper, log(1+rate)' datatype='real' name='[log1p_fatalities_per_100k_high]' role='measure' type='quantitative' />
      <column caption='MPI standard error (2021)' datatype='real' name='[mpi_se]' role='measure' type='quantitative' />
      <column caption='H standard error (2021)' datatype='real' name='[headcount_se]' role='measure' type='quantitative' />
      <column caption='Vulnerable to poverty, % of population (2021)' datatype='real' name='[vulnerable_pct]' role='measure' type='quantitative' />
      <column caption='In severe poverty, % of population (2021)' datatype='real' name='[severe_pct]' role='measure' type='quantitative' />
      <column caption='Health share of the MPI (2021)' datatype='real' name='[contrib_health_pct]' role='measure' type='quantitative' />
      <column caption='Education share of the MPI (2021)' datatype='real' name='[contrib_education_pct]' role='measure' type='quantitative' />
      <column caption='Living standards share of the MPI (2021)' datatype='real' name='[contrib_living_standards_pct]' role='measure' type='quantitative' />
      <column caption='Population (thousands)' datatype='real' name='[population_thousands]' role='measure' type='quantitative' />
      <column caption='People in MPI poverty (thousands)' datatype='real' name='[mpi_poor_thousands]' role='measure' type='quantitative' />
      <column caption='Capital rainfall in the survey year (mm)' datatype='real' name='[precip_total_mm]' role='measure' type='quantitative' />
      <column caption='Capital temperature, 1991-2020 mean (C)' datatype='real' name='[baseline_temp_c]' role='measure' type='quantitative' />
      <column caption='Capital rainfall, 1991-2020 mean (mm/yr)' datatype='real' name='[baseline_precip_mm]' role='measure' type='quantitative' />
      <column caption='Latitude (capital)' datatype='real' name='[lat]' role='measure' type='quantitative' semantic-role='[Geographical].[Latitude]' />
      <column caption='Longitude (capital)' datatype='real' name='[lon]' role='measure' type='quantitative' semantic-role='[Geographical].[Longitude]' />
            <column caption='Pair X position' datatype='real' name='[pair_x_sel]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[X axis measure]&#10;WHEN &quot;H (% poor)&quot; THEN [headcount_ratio_pct]&#10;WHEN &quot;MPI&quot; THEN [mpi]&#10;WHEN &quot;Depth (avg deprivation among the poor, %)&quot; THEN [intensity_pct]&#10;WHEN &quot;Capital temperature in the round (C)&quot; THEN [temp_mean_c]&#10;WHEN &quot;UCDP events per 100k&quot; THEN [events_per_100k]&#10;WHEN &quot;UCDP events per 100k, log(1+rate)&quot; THEN [log1p_events_per_100k]&#10;WHEN &quot;UCDP deaths per 100k&quot; THEN [fatalities_per_100k]&#10;WHEN &quot;UCDP deaths per 100k, log(1+rate)&quot; THEN [log1p_fatalities_per_100k]&#10;WHEN &quot;UCDP deaths per 100k, upper estimate&quot; THEN [fatalities_per_100k_high]&#10;WHEN &quot;UCDP deaths per 100k, upper, log(1+rate)&quot; THEN [log1p_fatalities_per_100k_high]&#10;WHEN &quot;MPI standard error (2021)&quot; THEN [mpi_se]&#10;WHEN &quot;H standard error (2021)&quot; THEN [headcount_se]&#10;WHEN &quot;Vulnerable to poverty, % of population (2021)&quot; THEN [vulnerable_pct]&#10;WHEN &quot;In severe poverty, % of population (2021)&quot; THEN [severe_pct]&#10;WHEN &quot;Health share of the MPI (2021)&quot; THEN [contrib_health_pct]&#10;WHEN &quot;Education share of the MPI (2021)&quot; THEN [contrib_education_pct]&#10;WHEN &quot;Living standards share of the MPI (2021)&quot; THEN [contrib_living_standards_pct]&#10;WHEN &quot;Population (thousands)&quot; THEN [population_thousands]&#10;WHEN &quot;People in MPI poverty (thousands)&quot; THEN [mpi_poor_thousands]&#10;WHEN &quot;Capital rainfall in the survey year (mm)&quot; THEN [precip_total_mm]&#10;WHEN &quot;Capital temperature, 1991-2020 mean (C)&quot; THEN [baseline_temp_c]&#10;WHEN &quot;Capital rainfall, 1991-2020 mean (mm/yr)&quot; THEN [baseline_precip_mm]&#10;WHEN &quot;Latitude (capital)&quot; THEN [lat]&#10;WHEN &quot;Longitude (capital)&quot; THEN [lon]&#10;END' />
      </column>
            <column caption='Pair Y position' datatype='real' name='[pair_y_sel]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Y axis measure]&#10;WHEN &quot;H (% poor)&quot; THEN [headcount_ratio_pct]&#10;WHEN &quot;MPI&quot; THEN [mpi]&#10;WHEN &quot;Depth (avg deprivation among the poor, %)&quot; THEN [intensity_pct]&#10;WHEN &quot;Capital temperature in the round (C)&quot; THEN [temp_mean_c]&#10;WHEN &quot;UCDP events per 100k&quot; THEN [events_per_100k]&#10;WHEN &quot;UCDP events per 100k, log(1+rate)&quot; THEN [log1p_events_per_100k]&#10;WHEN &quot;UCDP deaths per 100k&quot; THEN [fatalities_per_100k]&#10;WHEN &quot;UCDP deaths per 100k, log(1+rate)&quot; THEN [log1p_fatalities_per_100k]&#10;WHEN &quot;UCDP deaths per 100k, upper estimate&quot; THEN [fatalities_per_100k_high]&#10;WHEN &quot;UCDP deaths per 100k, upper, log(1+rate)&quot; THEN [log1p_fatalities_per_100k_high]&#10;WHEN &quot;MPI standard error (2021)&quot; THEN [mpi_se]&#10;WHEN &quot;H standard error (2021)&quot; THEN [headcount_se]&#10;WHEN &quot;Vulnerable to poverty, % of population (2021)&quot; THEN [vulnerable_pct]&#10;WHEN &quot;In severe poverty, % of population (2021)&quot; THEN [severe_pct]&#10;WHEN &quot;Health share of the MPI (2021)&quot; THEN [contrib_health_pct]&#10;WHEN &quot;Education share of the MPI (2021)&quot; THEN [contrib_education_pct]&#10;WHEN &quot;Living standards share of the MPI (2021)&quot; THEN [contrib_living_standards_pct]&#10;WHEN &quot;Population (thousands)&quot; THEN [population_thousands]&#10;WHEN &quot;People in MPI poverty (thousands)&quot; THEN [mpi_poor_thousands]&#10;WHEN &quot;Capital rainfall in the survey year (mm)&quot; THEN [precip_total_mm]&#10;WHEN &quot;Capital temperature, 1991-2020 mean (C)&quot; THEN [baseline_temp_c]&#10;WHEN &quot;Capital rainfall, 1991-2020 mean (mm/yr)&quot; THEN [baseline_precip_mm]&#10;WHEN &quot;Latitude (capital)&quot; THEN [lat]&#10;WHEN &quot;Longitude (capital)&quot; THEN [lon]&#10;END' />
      </column>
      <column-instance column='[pair_x_sel]' derivation='Avg' name='[avg:pair_x_sel:qk]' pivot='key' type='quantitative' />
      <column-instance column='[pair_y_sel]' derivation='Avg' name='[avg:pair_y_sel:qk]' pivot='key' type='quantitative' />
      <column-instance column='[poverty_group]' derivation='None' name='[none:poverty_group:nk]' pivot='key' type='nominal' />
      <column-instance column='[state]' derivation='None' name='[none:state:nk]' pivot='key' type='nominal' />
      <column-instance column='[survey_year]' derivation='None' name='[none:survey_year:ok]' pivot='key' type='ordinal' />
      <column-instance column='[pcode]' derivation='None' name='[none:pcode:nk]' pivot='key' type='nominal' />
      <column-instance column='[survey]' derivation='None' name='[none:survey:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='Parameters'>
          <column caption='X axis measure' datatype='string' name='[X axis measure]' param-domain-type='list' role='measure' type='nominal' value='&quot;H (% poor)&quot;'>
            <calculation class='tableau' formula='&quot;H (% poor)&quot;' />
            <members>
              <member value='&quot;H (% poor)&quot;' />
              <member value='&quot;MPI&quot;' />
