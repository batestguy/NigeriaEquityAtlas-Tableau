    <worksheet name='A state over time'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='13'>A state over time</run><run fontsize='9'>  labels are the state's rank of 37 in that round: 1 = the measure's highest value (poorest MPI, most conflict, hottest capital), higher = away from the extreme · stars flag OPHI-significant movement · not a trend; ranks don't separate at 95%</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='A state over time' name='federated.0mpitrends' />
          </datasources>
          <datasource-dependencies>
      <column caption='pcode' datatype='string' name='[pcode]' role='dimension' type='nominal' />
      <column caption='state' datatype='string' name='[state]' role='dimension' type='nominal' semantic-role='[State].[Name]' />
      <column caption='survey_year' datatype='integer' name='[survey_year]' role='dimension' type='ordinal' />
      <column caption='Survey the round comes from' datatype='string' name='[survey]' role='dimension' type='nominal' />
      <column caption='Movement OPHI&apos;s change test calls significant (*, **, ***)' datatype='string' name='[mpi_change_significant]' role='dimension' type='nominal' />
      <column caption='Mean annual change since the previous round (MPI points/yr)' datatype='string' name='[mpi_change_label]' role='dimension' type='nominal' />
      <column caption='Conflict deaths per 100,000 (upper estimate)' datatype='string' name='[deaths_high_label]' role='dimension' type='nominal' />
      <column caption='MPI · rank (1 = highest)' datatype='integer' default-format='&quot;R&quot;0' name='[rank_mpi]' role='measure' type='quantitative' />
      <column caption='H % poor · rank (1 = highest)' datatype='integer' default-format='&quot;R&quot;0' name='[rank_headcount]' role='measure' type='quantitative' />
      <column caption='Intensity A · rank (1 = highest)' datatype='integer' default-format='&quot;R&quot;0' name='[rank_intensity]' role='measure' type='quantitative' />
      <column caption='Conflict events/100k · rank (1 = highest)' datatype='integer' default-format='&quot;R&quot;0' name='[rank_events]' role='measure' type='quantitative' />
      <column caption='Conflict deaths/100k · rank (1 = highest)' datatype='integer' default-format='&quot;R&quot;0' name='[rank_deaths]' role='measure' type='quantitative' />
      <column caption='Capital temp · rank (1 = highest)' datatype='integer' default-format='&quot;R&quot;0' name='[rank_temp]' role='measure' type='quantitative' />
      <column-instance column='[survey_year]' derivation='None' name='[none:survey_year:ok]' pivot='key' type='ordinal' />
      <column-instance column='[state]' derivation='None' name='[none:state:nk]' pivot='key' type='nominal' />
      <column-instance column='[survey_year]' derivation='None' name='[none:survey_year:nk]' pivot='key' type='nominal' />
      <column-instance column='[survey]' derivation='None' name='[none:survey:nk]' pivot='key' type='nominal' />
      <column-instance column='[mpi_change_label]' derivation='None' name='[none:mpi_change_label:nk]' pivot='key' type='nominal' />
      <column-instance column='[mpi_change_significant]' derivation='None' name='[none:mpi_change_significant:nk]' pivot='key' type='nominal' />
      <column-instance column='[deaths_high_label]' derivation='None' name='[none:deaths_high_label:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0mpitrends].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
          <groupfilter function='member' level='[:Measure Names]' member="&quot;[federated.0mpitrends].[sum:rank_mpi:qk]&quot;" />
          <groupfilter function='member' level='[:Measure Names]' member="&quot;[federated.0mpitrends].[sum:rank_headcount:qk]&quot;" />
          <groupfilter function='member' level='[:Measure Names]' member="&quot;[federated.0mpitrends].[sum:rank_intensity:qk]&quot;" />
          <groupfilter function='member' level='[:Measure Names]' member="&quot;[federated.0mpitrends].[sum:rank_events:qk]&quot;" />
          <groupfilter function='member' level='[:Measure Names]' member="&quot;[federated.0mpitrends].[sum:rank_deaths:qk]&quot;" />
          <groupfilter function='member' level='[:Measure Names]' member="&quot;[federated.0mpitrends].[sum:rank_temp:qk]&quot;" />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.0mpitrends].[none:state:nk]'>
            <groupfilter function='member' level='[none:state:nk]' member="&quot;Bauchi&quot;" />
          </filter>
          <aggregation value='true' />
        </view>
        <style>          <style-rule element='axis'>
            <format attr='display' class='0' field='[federated.0mpitrends].[Multiple Values]' scope='rows' value='false' />
          </style-rule>
</style>
      <panes>
        <pane selection-relaxation-option='selection-relaxation-allow'>
          <view>
            <breakdown value='auto' />
          </view>
          <mark class='Line' />
          <encodings>
            <color column='[federated.0mpitrends].[:Measure Names]' />
          </encodings>
          <customized-tooltip show-buttons='false'>
            <formatted-text>
              <run bold='true' fontsize='13'><![CDATA[<[federated.0mpitrends].[none:state:nk]>]]></run>
              <run> &#183; </run>
              <run bold='true'><![CDATA[<[federated.0mpitrends].[none:survey_year:nk]>]]></run>
