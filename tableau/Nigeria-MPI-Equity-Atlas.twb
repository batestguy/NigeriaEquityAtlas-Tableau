    <worksheet name='Where poverty clusters'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='13'>Where poverty clusters</run><run fontsize='9'>  Poverty beside the neighbours' · a grouping, not a significance test</run>
