    <datasource caption='Poverty composition' inline='true' name='federated.0mpidimshare' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='Extract' name='hyper.0mpidimshare'>
            <connection access_mode='readonly' author-locale='en' class='hyper' dbname='Data/dimension_shares.hyper' default-settings='hyper' schema='Extract' sslmode='' tablename='Extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </connection>
          </named-connection>
        </named-connections>
        <relation connection='hyper.0mpidimshare' name='Extract' table='[Extract].[Extract]' type='table' />
      </connection>
      <aliases enabled='yes' />
      <column caption='pcode' datatype='string' name='[pcode]' role='dimension' type='nominal' />
      <column caption='state' datatype='string' name='[state]' role='dimension' type='nominal' semantic-role='[State].[Name]' />
      <column caption='Poverty group' datatype='string' name='[poverty_group]' role='dimension' type='nominal' />
      <column caption='MPI (as a % of the index)' datatype='string' name='[mpi_label]' role='dimension' type='nominal' />
      <column caption='Education' datatype='real' name='[contrib_education_pct]' role='measure' type='quantitative' />
      <column caption='Health' datatype='real' name='[contrib_health_pct]' role='measure' type='quantitative' />
      <column caption='Living standards' datatype='real' name='[contrib_living_standards_pct]' role='measure' type='quantitative' />
      <column caption='State selection (Overview)' datatype='boolean' name='[state_match]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[State select] = [state] OR ([Parameters].[State select] = &quot;(All states)&quot; AND ([state] = &quot;Bauchi&quot; OR [state] = &quot;Jigawa&quot; OR [state] = &quot;Kebbi&quot; OR [state] = &quot;Sokoto&quot; OR [state] = &quot;Zamfara&quot; OR [state] = &quot;Yobe&quot; OR [state] = &quot;Plateau&quot; OR [state] = &quot;Nasarawa&quot; OR [state] = &quot;Adamawa&quot; OR [state] = &quot;Kaduna&quot; OR [state] = &quot;Benue&quot; OR [state] = &quot;Kwara&quot; OR [state] = &quot;Ogun&quot; OR [state] = &quot;Oyo&quot; OR [state] = &quot;Cross River&quot; OR [state] = &quot;Bayelsa&quot; OR [state] = &quot;Kogi&quot; OR [state] = &quot;Ondo&quot;))' />
      </column>
      <column-instance column='[contrib_education_pct]' derivation='Sum' name='[sum:contrib_education_pct:qk]' pivot='key' type='quantitative' />
      <column-instance column='[contrib_health_pct]' derivation='Sum' name='[sum:contrib_health_pct:qk]' pivot='key' type='quantitative' />
      <column-instance column='[contrib_living_standards_pct]' derivation='Sum' name='[sum:contrib_living_standards_pct:qk]' pivot='key' type='quantitative' />
      <column-instance column='[state_match]' derivation='None' name='[none:state_match:nk]' pivot='key' type='nominal' />
      <column-instance column='[state]' derivation='None' name='[none:state:nk]' pivot='key' type='nominal' />
      <column-instance column='[poverty_group]' derivation='None' name='[none:poverty_group:nk]' pivot='key' type='nominal' />
      <column-instance column='[mpi_label]' derivation='None' name='[none:mpi_label:nk]' pivot='key' type='nominal' />
      <column-instance column='[dim_hover]' derivation='None' name='[none:dim_hover:nk]' pivot='key' type='nominal' />
      <extract count='-1' enabled='true' units='records'>
        <connection access_mode='readonly' author-locale='en' class='hyper' dbname='Data/dimension_shares.hyper' default-settings='hyper' schema='Extract' sslmode='' tablename='Extract'>
          <relation name='Extract' table='[Extract].[Extract]' type='table' />
        </connection>
      </extract>
      <layout dim-ordering='alphabetic' dim-percentage='0.5' measure-ordering='alphabetic' measure-percentage='0.4' show-structure='true' />
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[:Measure Names]' type='palette'>
            <map to='#0072B2'>
              <bucket>&quot;[federated.0mpidimshare].[sum:contrib_education_pct:qk]&quot;</bucket>
            </map>
            <map to='#E69F00'>
              <bucket>&quot;[federated.0mpidimshare].[sum:contrib_health_pct:qk]&quot;</bucket>
            </map>
            <map to='#009E73'>
              <bucket>&quot;[federated.0mpidimshare].[sum:contrib_living_standards_pct:qk]&quot;</bucket>
            </map>
          </encoding>
        </style-rule>
      </style>
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;Nigeria&quot;' />
      </semantic-values>
