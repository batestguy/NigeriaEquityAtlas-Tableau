      <column caption='State selection (Overview)' datatype='boolean' name='[state_match]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[state] = [Parameters].[State select] OR [Parameters].[State select] = &quot;(All states)&quot;' />
      </column>
      <column-instance column='[state_match]' derivation='None' name='[none:state_match:nk]' pivot='key' type='nominal' />
