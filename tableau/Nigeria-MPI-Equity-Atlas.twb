    </worksheet>
    <worksheet name='Where Nigeria stands'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='13'>Where Nigeria stands</run><run fontsize='9'>  Nigeria beside its 2021 reference points · every row has its own scale: a mark's number is its share of that row's largest reference · the actual values, benchmark and source are on hover, at one decimal · the world line is developing countries (109 of them, OPHI/UNDP), not every country · point estimates</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Where Nigeria stands' name='federated.0kpiboard' />
          </datasources>
          <datasource-dependencies>
      <column caption='Indicator' datatype='string' name='[kpi]' role='dimension' type='nominal' />
      <column caption='Reference point (2021)' datatype='string' name='[series]' role='dimension' type='nominal' />
      <column caption='Values behind this mark' datatype='string' name='[hover]' role='dimension' type='nominal' />
      <column caption='Share of this row&apos;s largest reference point' datatype='real' default-format='0.0' name='[pos]' role='measure' type='quantitative' />
      <column caption='Value beside the map' datatype='string' name='[pos_label]' role='dimension' type='nominal' />
      <column-instance column='[kpi]' derivation='None' name='[none:kpi:nk]' pivot='key' type='nominal' />
      <column-instance column='[pos]' derivation='Avg' name='[avg:pos:qk]' pivot='key' type='quantitative' />
      <column-instance column='[hover]' derivation='None' name='[none:hover:nk]' pivot='key' type='nominal' />
      <column-instance column='[series]' derivation='None' name='[none:series:nk]' pivot='key' type='nominal' />
      <column-instance column='[pos_label]' derivation='None' name='[none:pos_label:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <sort class='manual' column='[federated.0kpiboard].[none:kpi:nk]' direction='ASC'>
            <dictionary>
            <bucket>&quot;Poverty headcount (% of people)&quot;</bucket>
            <bucket>&quot;Child deaths under 5 (per 1,000 births)&quot;</bucket>
            <bucket>&quot;Open defecation (% of people)&quot;</bucket>
            <bucket>&quot;Safely managed sanitation (% of people)&quot;</bucket>
            <bucket>&quot;At least basic drinking water (% of people)&quot;</bucket>
            <bucket>&quot;Access to electricity (% of people)&quot;</bucket>
            <bucket>&quot;Clean cooking fuel (% of people)&quot;</bucket>
            </dictionary>
          </sort>
          <aggregation value='true' />
        </view>
        <style>          <style-rule element='axis'>
            <encoding attr='space' class='0' field='[federated.0kpiboard].[avg:pos:qk]' field-type='quantitative' major-origin='0' major-spacing='0.5' scope='cols' type='space' />
          </style-rule>
</style>
      <panes>
        <pane selection-relaxation-option='selection-relaxation-allow'>
          <view>
            <breakdown value='auto' />
          </view>
          <mark class='Shape' />
          <encodings>
            <lod column='[federated.0kpiboard].[none:hover:nk]' />
            <color column='[federated.0kpiboard].[none:series:nk]' />
            <shape column='[federated.0kpiboard].[none:series:nk]' />
            <text column='[federated.0kpiboard].[none:pos_label:nk]' />
          </encodings>
