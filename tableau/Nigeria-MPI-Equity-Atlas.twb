    <worksheet name='How poverty is made up'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='13'>How poverty is made up</run><run fontsize='9'>  What each state's poverty is made of · shares of the MPI, adding to 100 · MPI order, not a ranking · 18 of 37 bars by default: the top half of each group, the left control picks one</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Poverty composition' name='federated.0mpidimshare' />
          </datasources>
