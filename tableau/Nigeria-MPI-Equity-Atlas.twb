      <extract count='-1' enabled='true' units='records'>
        <connection access_mode='readonly' author-locale='en' class='hyper' dbname='Data/mpi_polygons.hyper' default-settings='hyper' schema='Extract' sslmode='' tablename='Extract'>
          <relation name='Extract' table='[Extract].[Extract]' type='table' />
        </connection>
      </extract>
      <layout dim-ordering='alphabetic' dim-percentage='0.5' measure-ordering='alphabetic' measure-percentage='0.4' show-structure='true' />
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[none:mpi_band:nk]' type='palette'>
            <map to='#ffe5e5'>
              <bucket>&quot;1. under 5%&quot;</bucket>
            </map>
            <map to='#ffb8b8'>
              <bucket>&quot;2. 5% to 10%&quot;</bucket>
            </map>
            <map to='#ff8a8a'>
              <bucket>&quot;3. 10% to 20%&quot;</bucket>
            </map>
            <map to='#f45555'>
              <bucket>&quot;4. 20% to 30%&quot;</bucket>
            </map>
            <map to='#d80000'>
              <bucket>&quot;5. 30% and above&quot;</bucket>
            </map>
          </encoding>
        </style-rule>
      </style>
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;Nigeria&quot;' />
      </semantic-values>
