# Raw downloads: re-fetchable via scripts/01..03, do not commit (sources get updated in place)
data/raw/*
!data/raw/_provenance.csv

# Python
__pycache__/
*.pyc
.venv/
# ruff cache
.ruff_cache/

# Stage 6 build artefacts: regenerated by scripts/06_build_twb.py and already
# carried inside the .twbx, so there is no reason to track them separately.
tableau/*.hyper
tableau/*.twbr
# Tableau's Hyper server writes this into the working directory.
hyperd.log

# Machine-specific map (user name, drive layout, credential locations). Local only -- see docs/HANDOFF.md section 8
ENVIRONMENTS.md
